{
  "name": "QCopy",
  "version": "1.0.3",
  "private": true,
  "description": "macOS 原生快速文件复制工具",
  "type": "module",
  "scripts": {
    "dev": "bun dev.ts",
    "debug": "bun debug.ts",
    "build": "bun release.ts --no-publish",
    "release": "bun release.ts",
    "clean": "bun scripts/clean.ts",
    "version": "1.0.3",
    "version+": "bun scripts/version-bump.ts",
    "web:dev": "qpage --dev ./web ./dist-web",
    "web:build": "qpage ./web ./dist-web",
    "web:preview": "qpage --preview ./web ./dist-web",
    "web:i18n:codex": "codex exec 根据./web/translate.md完成翻译任务",
    "web:publish": "bun run qzrzz-com up ./dist-web ./QCopy",
    "web:build-publish": "bun run bun web:build && bun run web:publish",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/node": "26.2.0",
    "chalk": "6.0.0",
    "qpage": "link:qpage"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  },
  "packageManager": "bun"
}
